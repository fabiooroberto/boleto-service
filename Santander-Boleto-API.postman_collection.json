{
  "info": {
    "name": "Santander Boleto Integration API",
    "description": "Complete API collection for testing Santander Boleto (Bank Slip) integration with santander-mock and boleto-service. All required fields must be present in POST/PATCH requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "12345678",
    "_collection_name": "Santander Boleto API"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{bearer_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Santander Mock (Port 8081)",
      "item": [
        {
          "name": "OAuth - Get Access Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  var jsonData = pm.response.json();",
                  "  pm.environment.set('bearer_token', jsonData.access_token);",
                  "  pm.environment.set('token_expires_in', jsonData.expires_in);",
                  "  console.log('Token saved: ' + jsonData.access_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "client_credentials"
                },
                {
                  "key": "client_id",
                  "value": "test-client"
                },
                {
                  "key": "client_secret",
                  "value": "test-secret"
                }
              ]
            },
            "url": {
              "raw": "http://localhost:8081/oauth/token",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8081",
              "path": [
                "oauth",
                "token"
              ]
            }
          }
        },
