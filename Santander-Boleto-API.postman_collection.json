              "mode": "raw",
              "raw": "{\n  \"covenantCode\": \"1234567\",\n  \"bankNumber\": \"033\",\n  \"dueDate\": \"2026-12-31\",\n  \"nominalValue\": \"250.50\",\n  \"documentKind\": \"DUPLICATA_MERCANTIL\",\n  \"nsuCode\": \"000001\",\n  \"nsuDate\": \"2026-07-30\",\n  \"issueDate\": \"2026-07-30\",\n  \"paymentType\": \"REGISTRO\",\n  \"environment\": \"TESTE\",\n  \"payer\": {\n    \"name\": \"João Silva Santos\",\n    \"documentType\": \"CPF\",\n    \"documentNumber\": \"12345678901\",\n    \"address\": \"Rua das Flores, 123\",\n    \"neighborhood\": \"Centro\",\n    \"city\": \"São Paulo\",\n    \"state\": \"SP\",\n    \"zipCode\": \"01310-100\"\n  },\n  \"beneficiary\": {\n    \"name\": \"Empresa LTDA\",\n    \"documentType\": \"CNPJ\",\n    \"documentNumber\": \"12345678901234\"\n  }\n}"
            },
