              "host": [
                "localhost"
              ],
              "port": "8081",
              "path": [
                "collection_bill_management",
                "v2",
                "workspaces",
                "test-workspace",
                "bank_slips"
              ]
            },
            "description": "Create a new bank slip with all required fields. Returns BoletoResponse (201 Created)"
